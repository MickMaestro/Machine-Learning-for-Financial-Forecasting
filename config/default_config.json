        "Is_Buy_Signal", "Is_Sell_Signal", "Relative_Position_In_Zone", "EMA_Slopes_Alignment",
        "Candle_Size_Ratio", "Is_Tight_Stop", "Is_Wide_Stop", "High_Signal_Activity", 
        "Low_Signal_Activity", "High_Spread", "Low_Spread"
      ],
      "interaction_features": [
        "Gann_EMA_Alignment", "Favorable_Time_Conditions", "Momentum_Alignment", "Fresh_Signal"
