{
  "metadata": {
    "saved_at": "2025-07-27T12:00:00.000000",
    "version": "1.0.1"
  },
  "config": {
    "application": {
      "name": "ML Financial Forecasting",
      "version": "1.0.1",
      "author": "Ibukunoluwa Michael Adebanjo",
      "description": "Machine Learning for Financial Market Forecasting"
    },
    "data": {
      "default_data_dir": "data",
      "supported_formats": [
        "csv",
        "excel",
        "json",
        "parquet"
      ],
      "max_file_size_mb": 500,
      "auto_backup": true,
      "validation_rules": {
        "min_rows": 100,
        "required_columns": [
          "Timestamp",
          "Signal_Type", 
          "Entry_Price",
          "Profit_Loss",
          "Gann_Zone_Width_Pips",
          "EMA_Separation_Pips",
          "Trading_Session",
          "Day_Of_Week",
          "Hour_Of_Day",
          "Spread"
        ],
        "data_exporter_2_format": true,
        "expected_feature_count": 24,
        "max_missing_percentage": 0.05
      }
    },
    "training": {
      "default_algorithms": [
        "Random Forest",
        "XGBoost",
        "LightGBM",
        "SVM",
        "LSTM",
        "Ensemble"
      ],
      "default_algorithm": "Random Forest",
      "training_method": "Time-Based Split",
      "default_test_size": 0.2,
      "default_random_state": 42,
      "hyperparameters": {
        "Random Forest": {
          "n_estimators": 200,
          "max_depth": 15,
          "min_samples_split": 4,
          "min_samples_leaf": 2,
          "class_weight": "balanced",
          "random_state": 42,
          "n_jobs": -1
        },
        "XGBoost": {
          "n_estimators": 200,
          "max_depth": 6,
          "learning_rate": 0.1,
          "subsample": 0.8,
          "colsample_bytree": 0.8,
          "random_state": 42,
          "eval_metric": "logloss",
          "verbosity": 0
        },
        "LightGBM": {
          "n_estimators": 200,
          "max_depth": 6,
          "learning_rate": 0.1,
          "subsample": 0.8,
          "colsample_bytree": 0.8,
          "random_state": 42,
          "verbose": -1,
          "objective": "binary",
          "metric": "binary_logloss",
          "boosting_type": "gbdt",
          "num_leaves": 31,
          "min_child_samples": 20,
          "reg_alpha": 0.0,
          "reg_lambda": 0.0
        },
        "SVM": {
          "C": 1.0,
          "kernel": "rbf",
          "gamma": "scale",
          "class_weight": "balanced",
          "random_state": 42,
          "probability": true
        },
        "LSTM": {
          "sequence_length": 10,
          "hidden_units": 50,
          "dropout": 0.2,
          "epochs": 50,
          "batch_size": 32,
          "learning_rate": 0.001
        },
        "Ensemble": {
          "base_algorithms": [
            "Random Forest",
            "XGBoost",
            "LightGBM"
          ],
          "meta_algorithm": "Random Forest",
          "voting": "soft",
          "cv_folds": 5
        }
      }
    },
    "prediction": {
      "default_confidence_threshold": 0.65,
      "batch_size": 1000,
      "save_predictions": true,
      "prediction_history_limit": 10000
    },
    "feature_engineering": {
      "data_exporter_2_format": true,
      "base_features": [
        "Gann_Zone_Width_Pips", "Gann_Zone_Slope", "Price_Distance_From_Zone_Center",
        "Price_Distance_From_Zone_Boundary", "Active_Gann_Line_Slope", "Bars_Since_Last_Gann_Color_Change",
        "EMA_Separation_Pips", "Median_EMA_Slope", "Low_EMA_Slope", "Price_Distance_From_Relevant_EMA",
        "EMA_Convergence_Divergence", "Trading_Session", "Day_Of_Week", "Hour_Of_Day",
        "Entry_Candle_Size_Pips", "Entry_Candle_Body_Ratio", "Previous_Candle_Size_Pips",
        "Bars_Since_Relevant_EMA_Cross", "Initial_SL_Distance_Pips", "Recent_Gann_Signal_Frequency"
      ],
      "derived_features": [
