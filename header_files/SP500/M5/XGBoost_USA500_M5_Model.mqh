#ifndef XGBOOST_USA500_M5_MODEL_MQH
#define XGBOOST_USA500_M5_MODEL_MQH

// Model Metadata
#define MODEL_ALGORITHM "XGBoost"
#define MODEL_SYMBOL "USA500"
#define MODEL_TIMEFRAME "M5"
#define MODEL_THRESHOLD 0.500000
#define MODEL_ACCURACY 0.0000
#define MODEL_PRECISION 0.0000
#define MODEL_RECALL 0.0000
#define MODEL_F1_SCORE 0.0000
#define TRAINING_DATE "2025-08-26"

// Top 10 feature indices (from 24 total features)
static int FEATURE_INDICES[10] = {0, 2, 6, 7, 10, 11, 14, 18, 20, 21};

// Feature names for debugging (optional)
static string FEATURE_NAMES[10] = {
    "Gann_Zone_Width_Pips",
    "Price_Distance_From_Zone_Center",
    "EMA_Separation_Pips",
    "Median_EMA_Slope",
    "EMA_Convergence_Divergence",
    "Trading_Session",
    "Entry_Candle_Size_Pips",
    "Initial_SL_Distance_Pips",
    "Spread",
    "Signal_Type"
};

// Coefficients for top 10 features
static double FEATURE_COEFFS[10] = {
    -0.00121224,  // Gann_Zone_Width_Pips (importance: 1.000)
    -0.00011097,  // Price_Distance_From_Zone_Center (importance: 0.900)
    0.00395228,  // EMA_Separation_Pips (importance: 0.800)
    -0.00375395,  // Median_EMA_Slope (importance: 0.700)
    0.00185026,  // EMA_Convergence_Divergence (importance: 0.600)
    0.03681342,  // Trading_Session (importance: 0.500)
    -0.00016872,  // Entry_Candle_Size_Pips (importance: 0.400)
    0.00159282,  // Initial_SL_Distance_Pips (importance: 0.300)
    0.06342435,  // Spread (importance: 0.200)
    0.02587857  // Signal_Type (importance: 0.100)
};

// Model bias term
static double MODEL_BIAS = -0.16216137;

//+------------------------------------------------------------------+
//| Main ML confidence evaluation function                          |
//+------------------------------------------------------------------+
bool evaluateMLConfidence(double &features[])
{
    // Calculate weighted sum using top 10 features
    double score = MODEL_BIAS;
    
    for(int i = 0; i < 10; i++)
    {
        int featureIdx = FEATURE_INDICES[i];
        if(featureIdx >= 0 && featureIdx < 24)
        {
            score += features[featureIdx] * FEATURE_COEFFS[i];
        }
    }
    
    // Apply algorithm-specific transformation
    double confidence = 1.0 / (1.0 + MathExp(-score));
    
    // Return true if confidence meets or exceeds threshold
    return confidence >= MODEL_THRESHOLD;
}

//+------------------------------------------------------------------+
//| Get actual confidence score (for debugging/analysis)            |
//+------------------------------------------------------------------+
double getConfidenceScore(double &features[])
{
    double score = MODEL_BIAS;
    
    for(int i = 0; i < 10; i++)
    {
        int featureIdx = FEATURE_INDICES[i];
        if(featureIdx >= 0 && featureIdx < 24)
        {
            score += features[featureIdx] * FEATURE_COEFFS[i];
        }
    }
    
    // Apply algorithm-specific transformation
    return 1.0 / (1.0 + MathExp(-score));
}

//+------------------------------------------------------------------+
//| Get model information string                                    |
//+------------------------------------------------------------------+
string getModelInfo()
{
    return StringFormat("Algorithm: %s | Symbol: %s | Timeframe: %s | Accuracy: %.2f%% | Threshold: %.3f",
                       MODEL_ALGORITHM, MODEL_SYMBOL, MODEL_TIMEFRAME, 
                       MODEL_ACCURACY * 100, MODEL_THRESHOLD);
}

